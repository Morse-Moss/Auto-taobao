<Slide style={{ width: '1280px', height: '720px', background: '#FFFFFF', fontFamily: 'Noto Sans SC', padding: '20px 64px', flexDirection: 'column' }}>
        <Box style={{ height: '96px', flexDirection: 'column', justifyContent: 'center' }}>
            <Text style={{ fontSize: '31px', fontWeight: 700, color: '#1B3557', lineHeight: 1.25 }}>四个动作：今天能做的、两周要做的、需要你点头的</Text>
            <Text style={{ fontSize: '15px', color: '#5F6975', lineHeight: 1.4, marginTop: '6px' }}>按顺序来，不要同时全上。每个动作都写清了对象、负责人、时间和验收数。</Text>
        </Box>
        <Box style={{ height: '540px', flexDirection: 'column', gap: '12px' }}>
            <Box style={{ flexDirection: 'row', background: '#F4F6F8', height: '118px', alignItems: 'center', paddingLeft: '20px', paddingRight: '20px', gap: '18px' }}>
                <Text style={{ fontSize: '34px', fontWeight: 700, color: '#A97B28', width: '40px' }}>1</Text>
                <Box style={{ width: '470px', flexDirection: 'column', gap: '6px' }}>
                    <Text style={{ fontSize: '16px', fontWeight: 700, color: '#1B3557' }}>止血：停投零成交商品</Text>
                    <Text style={{ fontSize: '12.5px', color: '#5F6975', lineHeight: 1.5 }}>对象：附录 A 的 72 个商品（18 天零成交）</Text>
                </Box>
                <Box style={{ width: '150px', flexDirection: 'column', gap: '4px' }}>
                    <Text style={{ fontSize: '11.5px', color: '#5F6975' }}>负责人</Text>
                    <Text style={{ fontSize: '13px', color: '#15181D', fontWeight: 600 }}>推广运营</Text>
                </Box>
                <Box style={{ width: '90px', flexDirection: 'column', gap: '4px' }}>
                    <Text style={{ fontSize: '11.5px', color: '#5F6975' }}>时间</Text>
                    <Text style={{ fontSize: '13px', color: '#15181D', fontWeight: 600 }}>今天</Text>
                </Box>
                <Box style={{ width: '240px', flexDirection: 'column', gap: '4px' }}>
                    <Text style={{ fontSize: '11.5px', color: '#5F6975' }}>验收数</Text>
                    <Text style={{ fontSize: '13px', color: '#AE4128', fontWeight: 600 }}>低效花费占比 62.2% → ≤40%</Text>
                </Box>
            </Box>
            <Box style={{ flexDirection: 'row', background: '#F4F6F8', height: '118px', alignItems: 'center', paddingLeft: '20px', paddingRight: '20px', gap: '18px' }}>
                <Text style={{ fontSize: '34px', fontWeight: 700, color: '#A97B28', width: '40px' }}>2</Text>
                <Box style={{ width: '470px', flexDirection: 'column', gap: '6px' }}>
                    <Text style={{ fontSize: '16px', fontWeight: 700, color: '#1B3557' }}>修商品页：流量大、几乎不成交的 4 个洗手盆</Text>
                    <Text style={{ fontSize: '12.5px', color: '#5F6975', lineHeight: 1.5 }}>对象：盖文立柱盆、科塔挂墙盆、盖文储物立柱盆、科塔超窄边</Text>
                </Box>
                <Box style={{ width: '150px', flexDirection: 'column', gap: '4px' }}>
                    <Text style={{ fontSize: '11.5px', color: '#5F6975' }}>负责人</Text>
                    <Text style={{ fontSize: '13px', color: '#15181D', fontWeight: 600 }}>商品运营</Text>
                </Box>
                <Box style={{ width: '90px', flexDirection: 'column', gap: '4px' }}>
                    <Text style={{ fontSize: '11.5px', color: '#5F6975' }}>时间</Text>
                    <Text style={{ fontSize: '13px', color: '#15181D', fontWeight: 600 }}>两周内</Text>
                </Box>
                <Box style={{ width: '240px', flexDirection: 'column', gap: '4px' }}>
                    <Text style={{ fontSize: '11.5px', color: '#5F6975' }}>验收数</Text>
                    <Text style={{ fontSize: '13px', color: '#AE4128', fontWeight: 600 }}>加购率 1.30% → 2.00%</Text>
                </Box>
            </Box>
            <Box style={{ flexDirection: 'row', background: '#F4F6F8', height: '118px', alignItems: 'center', paddingLeft: '20px', paddingRight: '20px', gap: '18px' }}>
                <Text style={{ fontSize: '34px', fontWeight: 700, color: '#A97B28', width: '40px' }}>3</Text>
                <Box style={{ width: '470px', flexDirection: 'column', gap: '6px' }}>
                    <Text style={{ fontSize: '16px', fontWeight: 700, color: '#1B3557' }}>挪流量：从最差 4 家店调出来</Text>
                    <Text style={{ fontSize: '12.5px', color: '#5F6975', lineHeight: 1.5 }}>对象：盖文全卫定制、Paola Lenti保拉伦蒂、网林全卫定制、科塔全卫定制</Text>
                </Box>
                <Box style={{ width: '150px', flexDirection: 'column', gap: '4px' }}>
                    <Text style={{ fontSize: '11.5px', color: '#5F6975' }}>负责人</Text>
                    <Text style={{ fontSize: '13px', color: '#15181D', fontWeight: 600 }}>店铺运营</Text>
                </Box>
                <Box style={{ width: '90px', flexDirection: 'column', gap: '4px' }}>
                    <Text style={{ fontSize: '11.5px', color: '#5F6975' }}>时间</Text>
                    <Text style={{ fontSize: '13px', color: '#15181D', fontWeight: 600 }}>两周内</Text>
                </Box>
                <Box style={{ width: '240px', flexDirection: 'column', gap: '4px' }}>
                    <Text style={{ fontSize: '11.5px', color: '#5F6975' }}>验收数</Text>
                    <Text style={{ fontSize: '13px', color: '#AE4128', fontWeight: 600 }}>每千次进店成交 1.6 → 2.0 单</Text>
                </Box>
            </Box>
            <Box style={{ flexDirection: 'row', background: '#F4F6F8', height: '118px', alignItems: 'center', paddingLeft: '20px', paddingRight: '20px', gap: '18px' }}>
                <Text style={{ fontSize: '34px', fontWeight: 700, color: '#A97B28', width: '40px' }}>4</Text>
                <Box style={{ width: '470px', flexDirection: 'column', gap: '6px' }}>
                    <Text style={{ fontSize: '16px', fontWeight: 700, color: '#1B3557' }}>并表：销售 2 部 5 家店接进同一张表</Text>
                    <Text style={{ fontSize: '12.5px', color: '#5F6975', lineHeight: 1.5 }}>对象：销售 2 部 5 家店（Paola Lenti 保拉伦蒂、保拉伦蒂旗舰店等）</Text>
                </Box>
                <Box style={{ width: '150px', flexDirection: 'column', gap: '4px' }}>
                    <Text style={{ fontSize: '11.5px', color: '#5F6975' }}>负责人</Text>
                    <Text style={{ fontSize: '13px', color: '#15181D', fontWeight: 600 }}>数据负责人 + 销售 2 部</Text>
                </Box>
                <Box style={{ width: '90px', flexDirection: 'column', gap: '4px' }}>
                    <Text style={{ fontSize: '11.5px', color: '#5F6975' }}>时间</Text>
                    <Text style={{ fontSize: '13px', color: '#15181D', fontWeight: 600 }}>本周内约</Text>
                </Box>
                <Box style={{ width: '240px', flexDirection: 'column', gap: '4px' }}>
                    <Text style={{ fontSize: '11.5px', color: '#5F6975' }}>验收数</Text>
                    <Text style={{ fontSize: '13px', color: '#AE4128', fontWeight: 600 }}>5 家并进同一张表、口径一致</Text>
                </Box>
            </Box>
        </Box>
        <Box style={{ height: '40px', flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center' }}>
            <Text style={{ fontSize: '13px', color: '#5F6975' }}>经营数据诊断 · 2026-10-20</Text>
            <Text style={{ fontSize: '13px', color: '#5F6975' }}>09 / 13</Text>
        </Box>
    </Slide>

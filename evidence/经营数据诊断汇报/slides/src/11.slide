<Slide style={{ width: '1280px', height: '720px', background: '#FFFFFF', fontFamily: 'Noto Sans SC', padding: '20px 64px', flexDirection: 'column' }}>
        <Box style={{ height: '96px', flexDirection: 'column', justifyContent: 'center' }}>
            <Text style={{ fontSize: '31px', fontWeight: 700, color: '#1B3557', lineHeight: 1.25 }}>需要你定的三件事</Text>
            <Text style={{ fontSize: '15px', color: '#5F6975', lineHeight: 1.4, marginTop: '6px' }}>定了今天就能开始，不定就还是现在这样。</Text>
        </Box>
        <Box style={{ height: '540px', flexDirection: 'column', gap: '18px' }}>
            <Box style={{ flexDirection: 'row', alignItems: 'center', height: '120px', borderLeft: '5px solid #AE4128', background: '#F4F6F8', paddingLeft: '24px', paddingRight: '24px', gap: '22px' }}>
                <Text style={{ fontSize: '19px', fontWeight: 700, color: '#AE4128', width: '100px' }}>批名单</Text>
                <Box style={{ width: '640px', flexDirection: 'column', gap: '6px' }}>
                    <Text style={{ fontSize: '17px', fontWeight: 600, color: '#1B3557' }}>附录 A 那 72 个零成交商品，今天就停投</Text>
                    <Text style={{ fontSize: '12.5px', color: '#5F6975' }}>18 天已经花掉 13,120 元，一次成交都没有</Text>
                </Box>
            </Box>
            <Box style={{ flexDirection: 'row', alignItems: 'center', height: '120px', borderLeft: '5px solid #A97B28', background: '#F4F6F8', paddingLeft: '24px', paddingRight: '24px', gap: '22px' }}>
                <Text style={{ fontSize: '19px', fontWeight: 700, color: '#A97B28', width: '100px' }}>给许可</Text>
                <Box style={{ width: '640px', flexDirection: 'column', gap: '6px' }}>
                    <Text style={{ fontSize: '17px', fontWeight: 600, color: '#1B3557' }}>两周试跑，不新增预算</Text>
                    <Text style={{ fontSize: '12.5px', color: '#5F6975' }}>只动现有的推广预算和店内流量，不额外申请费用</Text>
                </Box>
            </Box>
            <Box style={{ flexDirection: 'row', alignItems: 'center', height: '120px', borderLeft: '5px solid #A97B28', background: '#F4F6F8', paddingLeft: '24px', paddingRight: '24px', gap: '22px' }}>
                <Text style={{ fontSize: '19px', fontWeight: 700, color: '#A97B28', width: '100px' }}>给授权</Text>
                <Box style={{ width: '640px', flexDirection: 'column', gap: '6px' }}>
                    <Text style={{ fontSize: '17px', fontWeight: 600, color: '#1B3557' }}>约销售 2 部，把 5 家店并进同一张表</Text>
                    <Text style={{ fontSize: '12.5px', color: '#5F6975' }}>并完这一份数据才覆盖 12 家店，口径才算齐</Text>
                </Box>
            </Box>
            <Box style={{ marginTop: 'auto', flexDirection: 'row', justifyContent: 'space-between', alignItems: 'flex-end' }}>
                <Text style={{ fontSize: '16px', color: '#5F6975' }}>两周后拿五个数回来对。</Text>
                <Text style={{ fontSize: '12.5px', color: '#5F6975' }}>数据区间 2026-10-01 至 2026-10-18　·　12 家店铺</Text>
            </Box>
        </Box>
        <Box style={{ height: '40px', flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center' }}>
            <Text style={{ fontSize: '13px', color: '#5F6975' }}>经营数据诊断 · 2026-10-20</Text>
            <Text style={{ fontSize: '13px', color: '#5F6975' }}>11 / 13</Text>
        </Box>
    </Slide>

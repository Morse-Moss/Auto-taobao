<Slide style={{ width: '1280px', height: '720px', background: '#FFFFFF', fontFamily: 'Noto Sans SC', padding: '20px 64px', flexDirection: 'column' }}>
        <Box style={{ height: '96px', flexDirection: 'column', justifyContent: 'center' }}>
            <Text style={{ fontSize: '31px', fontWeight: 700, color: '#1B3557', lineHeight: 1.25 }}>附录 B：数据从哪来、怎么算的</Text>
            <Text style={{ fontSize: '15px', color: '#5F6975', lineHeight: 1.4, marginTop: '6px' }}>这一页只给要复核的人看，汇报时可以不讲。</Text>
        </Box>
        <Box style={{ height: '540px', flexDirection: 'row', gap: '44px' }}>
            <Box style={{ width: '520px', flexDirection: 'column' }}>
                <Text style={{ fontSize: '15px', fontWeight: 700, color: '#1B3557', marginBottom: '12px' }}>数据来源（飞书四张表，只读接口）</Text>
                <Box style={{ flexDirection: 'row', height: '54px', alignItems: 'center', borderBottom: '1px solid #DDE2E8' }}>
                    <Text style={{ fontSize: '13px', color: '#15181D', width: '120px', fontWeight: 600 }}>店铺日报</Text>
                    <Text style={{ fontSize: '13px', color: '#15181D', width: '120px' }}>2,433 行</Text>
                    <Text style={{ fontSize: '12px', color: '#5F6975', width: '260px' }}>本篇只取 10-01 至 10-18</Text>
                </Box>
                <Box style={{ flexDirection: 'row', height: '54px', alignItems: 'center', borderBottom: '1px solid #DDE2E8' }}>
                    <Text style={{ fontSize: '13px', color: '#15181D', width: '120px', fontWeight: 600 }}>商品日报</Text>
                    <Text style={{ fontSize: '13px', color: '#15181D', width: '120px' }}>4,221 行</Text>
                    <Text style={{ fontSize: '12px', color: '#5F6975', width: '260px' }}>10-01至10-18 无缺日；覆盖 8 家店（成交占 59.5%）</Text>
                </Box>
                <Box style={{ flexDirection: 'row', height: '54px', alignItems: 'center', borderBottom: '1px solid #DDE2E8' }}>
                    <Text style={{ fontSize: '13px', color: '#15181D', width: '120px', fontWeight: 600 }}>推广日报</Text>
                    <Text style={{ fontSize: '13px', color: '#15181D', width: '120px' }}>2,327 行</Text>
                    <Text style={{ fontSize: '12px', color: '#5F6975', width: '260px' }}>10-01至10-18 无缺日；覆盖 8 家店（广告占 98.9%）</Text>
                </Box>
                <Box style={{ flexDirection: 'row', height: '54px', alignItems: 'center', borderBottom: '1px solid #DDE2E8' }}>
                    <Text style={{ fontSize: '13px', color: '#15181D', width: '120px', fontWeight: 600 }}>询单</Text>
                    <Text style={{ fontSize: '13px', color: '#15181D', width: '120px' }}>891 行</Text>
                    <Text style={{ fontSize: '12px', color: '#5F6975', width: '260px' }}>无日期字段，本篇未使用</Text>
                </Box>
                <Text style={{ fontSize: '12px', color: '#5F6975', marginTop: '14px', lineHeight: 1.6 }}>四张表共 9,872 行。快照日 2026-10-20，之后补采的数据不进入本篇。</Text>
            </Box>
            <Box style={{ width: '520px', flexDirection: 'column', gap: '14px' }}>
                <Text style={{ fontSize: '15px', fontWeight: 700, color: '#1B3557' }}>三条口径，先说清楚</Text>
                <Box style={{ background: '#F4F6F8', padding: '13px 15px' }}>
                    <Text style={{ fontSize: '13px', fontWeight: 700, color: '#1B3557', marginBottom: '4px' }}>全部指标同一个窗口：18 天</Text>
                    <Text style={{ fontSize: '11.5px', color: '#15181D', lineHeight: 1.55 }}>所有数字都是 2026-10-01 至 2026-10-18。不用更长的窗口，是因为推广明细表只有这 18 天；拿 18 天的推广费去比更长时间的成交额，会人为把推广占比压低一半以上。</Text>
                </Box>
                <Box style={{ background: '#F4F6F8', padding: '13px 15px' }}>
                    <Text style={{ fontSize: '13px', fontWeight: 700, color: '#1B3557', marginBottom: '4px' }}>广告花费有两个来源，都是 18 天</Text>
                    <Text style={{ fontSize: '11.5px', color: '#15181D', lineHeight: 1.55 }}>日报表的广告花费 4.0万元（关键词 2.2万元＋人群 1.8万元）；推广明细表 2.8万元，等于日报口径的 68.4%。本篇说"推广费"一律指后者。</Text>
                </Box>
                <Box style={{ background: '#F4F6F8', padding: '13px 15px' }}>
                    <Text style={{ fontSize: '13px', fontWeight: 700, color: '#1B3557', marginBottom: '4px' }}>一个商品一个链接</Text>
                    <Text style={{ fontSize: '11.5px', color: '#15181D', lineHeight: 1.55 }}>所有商品数字按商品 ID 汇总，不按名称（同名商品会被错并）；推广按主体 ID 汇总。</Text>
                </Box>
            </Box>
        </Box>
        <Box style={{ height: '40px', flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center' }}>
            <Text style={{ fontSize: '13px', color: '#5F6975' }}>经营数据诊断 · 2026-10-20</Text>
            <Text style={{ fontSize: '13px', color: '#5F6975' }}>13 / 13</Text>
        </Box>
    </Slide>

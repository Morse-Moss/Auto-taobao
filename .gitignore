# Local credentials and environment overrides
.env
.env.*
!.env.example
*.pem
*.key
*.pfx
*.p12

# Dependencies and language caches
node_modules/
**/__pycache__/
*.py[cod]

# Editor and operating-system files
.idea/
.vscode/
.DS_Store
Thumbs.db

# Generated runtime evidence, backups, renders, and exports
runtime/**/*-backups/
runtime/**/*-runs/
runtime/**/*-render*/
runtime/**/images/
runtime/**/qa-*/
runtime/**/xws-api-*/
runtime/**/docx-qa-*/
runtime/**/*.json
runtime/**/*.jsonl
runtime/**/*.log
runtime/**/*.png
runtime/**/*.jpg
runtime/**/*.jpeg
runtime/**/*.webp
runtime/**/*.pdf
runtime/**/*.docx
runtime/**/*.xlsx
runtime/**/*.xls
runtime/**/*.csv
runtime/**/*.tsv
runtime/**/*.zip

# 出厂排期配置**要交付**：运营要改的就是它，不是生成物。上面那条 runtime/**/*.json 会连它一起吞掉，
# 被吞的后果是新机器上根本没有这份配置，而「没有配置」会被读成「不用跑」——一个安静的、永久的漏跑。
!runtime/round-schedule.json

# Local browser/runtime sessions and historical run artifacts
runtime/edge-isolated-*/
# `runtime/isolated-proxy/` 曾在这张表里，2026-09-17 起**纳入版本管理**：它已不是上游原样 vendored，
# 而是被本项目改过的工具链（浏览器身份/端口的默认值、代理监听端口都取自 runtime/browser-ports.mjs）。
# 忽略它 = 本机修复进不了版本库、新机器上连文件都没有，而守卫测试对不存在的目录是静默通过的
# —— 正是本文件 44-46 行记的那个坑换了个位置出现。
runtime/competitor-v2-*/
runtime/competitor-weekly-schema-migration/
runtime/competitor-v2-sku-collection/
runtime/keyword-analysis-backups/
runtime/keyword-analysis-receipts/
# FAQ operator 的周期状态目录（skills/xws-faq-operator 的权威工作区，勿删勿提交）
runtime/faq-analysis/
runtime/keyword-ops-review-render*/
runtime/keyword-dual-table-docx-render*/
runtime/keyword-decision-report*/
runtime/local-analysis-runs/
runtime/dashboard-sync-*/
runtime/period-fix-*/
runtime/weekly-runs/
runtime/huitun-runs/
runtime/top617-extract/
runtime/xws-api-*/
runtime/xws-runs*/
runtime/xws-bathtub-*-runs/
runtime/repair-weekly-images/
runtime/*-stability-round*/
runtime/*-dry-run*/
runtime/*-live*/
runtime/*.remote.js
runtime/*.remote.backup.js
runtime/sop-runtime/two-stage-*/
runtime/sop-runtime/weekly-*-20*/
/*-runs/
runtime/prompt-panel-inspect-copy.txt
runtime/screenshot-response.txt

# Temporary files
*.tmp
*.bak
*.swp

# Local tooling state and shell-accident artifacts (never commit)
.codegraph/
$d/
tmp-*-xlsx/
/checkpoint.json
/*-checkpoint.json
runtime/_*.txt

# Project-local agent memory (not part of the deliverable)
.workbuddy/
runtime/supervisor-agent/postmortems/
# 会话内的临时脚本/临时输出（探针、启动器副本）；用完即删，不纳入版本管理
runtime/tmp-*.mjs
runtime/tmp-*.txt
runtime/tmp-*.py

# 采集宿主的临时状态（子进程 pid / 退出码 / 心跳）。是运行态，不是产物；
# 不忽略它们会让每次 git status 都带 4 个噪音项。
runtime/.collect-child-pid
runtime/.collect-exit-code
runtime/.collection-host-heartbeat
runtime/.collection-host.pid

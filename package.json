{
  "name": "sycm-automation",
  "version": "1.7.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check:fast": "node scripts/check-fast.mjs",
    "check:staged": "node scripts/check-fast.mjs --staged",
    "check:delivery": "node scripts/delivery-status.mjs",
    "test:offline": "node scripts/run-offline-self-tests.mjs",
    "test:changed": "node scripts/run-affected-tests.mjs",
    "test:staged": "node scripts/run-affected-tests.mjs --staged",
    "test:unit": "node scripts/run-test-suite.mjs unit",
    "test:skills": "node scripts/run-test-suite.mjs skills",
    "test:runtime": "node scripts/run-test-suite.mjs runtime",
    "test:integration": "node scripts/run-test-suite.mjs integration",
    "test:all": "npm run check:fast && npm run test:offline && npm run test:unit",
    "test:agent-runtime": "node --test agent-runtime/tests/*.test.mjs",
    "run:agent-runtime-local": "node agent-runtime/run-local-task.mjs"
  },
  "dependencies": {
    "@temporalio/client": "^1.23.0",
    "@temporalio/testing": "^1.23.0",
    "@temporalio/worker": "^1.23.0",
    "@temporalio/workflow": "^1.23.0",
    "docx": "^9.7.1",
    "pg": "^8.23.0"
  }
}
